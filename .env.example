# انسخ هذا الملف إلى .env واملأ القيم الحقيقية

PORT=3000

# مفتاح سري لتوقيع جلسات الدخول (JWT) - غيّره إلى نص عشوائي طويل
JWT_SECRET=change-this-to-a-long-random-secret

# ---- إرسال البريد الإلكتروني (SMTP) ----
# مثال باستخدام Gmail: فعّل "كلمة مرور التطبيقات" App Password من إعدادات حساب Google
# أو استخدم أي مزوّد SMTP آخر (Mailtrap للتجربة، SendGrid، Brevo...)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=صحنك <youraddress@gmail.com>

# ---- إرسال الرسائل النصية SMS (Twilio) ----
# أنشئ حسابًا على https://www.twilio.com واحصل على القيم التالية من لوحة التحكم
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX

# ملاحظة: إذا تركت إعدادات SMTP أو Twilio فارغة، سيعمل الخادم في "وضع تجريبي"
# ويطبع رمز التحقق في الطرفية (Terminal) بدل إرساله فعليًا، دون أن يتوقف عن العمل.

# ---- الدفع الحقيقي (Flouci) ----
# رابط الموقع كما سيصل إليه الزبون (يُستخدم في روابط العودة بعد الدفع)
APP_URL=http://localhost:3000
# من https://developers.flouci.com بعد إنشاء تطبيق (App) داخل حسابك
FLOUCI_PUBLIC_KEY=your_flouci_app_token
FLOUCI_PRIVATE_KEY=your_flouci_app_secret
# سعر الاشتراك بالمليم (1 دينار = 1000 مليم). القيمة الافتراضية 29000 = 29.000 د.ت
SUBSCRIPTION_PRICE_MILLIMES=29000


